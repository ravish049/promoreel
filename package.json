    "@remotion/google-fonts": "4.0.539",
    "@remotion/install-whisper-cpp": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "kokoro-js": "1.2.1",
    "playwright-core": "1.64.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
