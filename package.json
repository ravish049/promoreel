{
  "name": "promoreel",
  "version": "0.1.0",
  "description": "Turn your web app into 1080×1920 promo reels with your own Claude Code or Codex. Free, local, no API keys.",
  "keywords": [
    "remotion",
    "claude-code",
    "codex",
    "video",
    "reels",
    "shorts",
    "promo",
    "product-demo",
    "playwright",
    "tts",
    "agent-skill"
  ],
  "homepage": "https://github.com/ravish049/promoreel#readme",
  "bugs": {
    "url": "https://github.com/ravish049/promoreel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravish049/promoreel.git"
  },
  "author": "Ravish Chadha",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "promoreel": "bin/promoreel.cjs"
  },
  "scripts": {
    "promoreel": "node bin/promoreel.cjs",
    "studio": "node bin/promoreel.cjs studio",
    "doctor": "node bin/promoreel.cjs doctor",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test cli/lib/*.test.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
