{
  "id": "todo-promo",
  "title": "Todo demo: one list, nothing extra",
  "voice": {
    "use": "af_heart",
    "speed": 1,
    "dtype": "fp32"
  },
  "captions": {
    "model": "base.en"
  },
  "crf": 24,
  "lines": [
    {
      "id": "hook",
      "say": "Got too much in your head right now?",
      "speed": 1
    },
    {
      "id": "quiz",
      "say": "So where do your to-dos actually live?",
      "text": "So where do your to-dos actually live?",
      "speed": 1.02
    },
    {
      "id": "reveal",
      "say": "Honestly? | Sticky notes get lost. | A list doesn't.",
      "speed": 1.02,
      "pauseMs": 280
    },
    {
      "id": "add",
      "say": "Type a task, | hit enter, | and it's on the list.",
      "speed": 1.03,
      "pauseMs": 240
    },
    {
      "id": "done",
      "say": "Done with one? | Tick it off, | and the counter drops.",
      "speed": 1.03,
      "pauseMs": 240
    },
    {
      "id": "filter",
      "say": "Filter what's left, | then clear the finished ones in a tap.",
      "speed": 1.02,
      "pauseMs": 260
    },
    {
      "id": "outro-close",
      "say": "The Todo demo. | One list, nothing extra.",
      "speed": 0.97,
      "pauseMs": 320
    },
    {
      "id": "outro-recap",
      "say": "Add it, tick it, filter it, clear it. | That's the whole app.",
      "speed": 1,
      "pauseMs": 300
    }
  ],
